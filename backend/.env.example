# SQLite works immediately for local development.
DATABASE_URL=sqlite:///./fixmycity.db
SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxx  # Enter your own secret key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

# For PostgreSQL instead, install psycopg[binary] and use:
# DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/fixmycity
